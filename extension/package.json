{
  "name": "vibeblog",
  "displayName": "VibeBlog",
  "description": "Visible thinking + mandatory guide on real VS Code — education IDE layer",
  "version": "0.1.0",
  "publisher": "genew-studio",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Education", "Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vibeblog.setFullUi",
        "title": "VibeBlog: 完整 IDE（成人/大學）"
      },
      {
        "command": "vibeblog.setCompactUi",
        "title": "VibeBlog: 簡化介面（小學）"
      },
      {
        "command": "vibeblog.openJournal",
        "title": "VibeBlog: 打開思考日誌"
      },
      {
        "command": "vibeblog.openLessonWorkspace",
        "title": "VibeBlog: 打開接水果工作區"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vibeblog",
          "title": "VibeBlog",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "vibeblog": [
        {
          "type": "webview",
          "id": "vibeblog.guide",
          "name": "思考關"
        }
      ]
    }
  }
}
