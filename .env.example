# --- Primary brain (Poe first) -----------------------------------------------
# Get a key at https://poe.com/api/keys — OpenAI-compatible at https://api.poe.com/v1
POE_API_KEY=
POE_MODEL=Claude-Haiku-4.5
POE_BASE_URL=https://api.poe.com/v1

# --- Optional fallbacks ------------------------------------------------------
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# V4 thinks by default; "disabled" keeps chat replies fast.
DEEPSEEK_THINKING=disabled

# --- Ling (InclusionAI) ------------------------------------------------------
# Ling is open-weight with no single official API, so set the base URL to match
# whoever issued your key. ZenMux is the default and is reachable here.
#   ZenMux      https://zenmux.ai/api/v1        model inclusionai/ling-3.0-flash
#   Novita      https://api.novita.ai/openai/v1 model inclusionai/ling-3.0-flash
#   OpenRouter  https://openrouter.ai/api/v1    model inclusionai/ling-3.0-flash
# Unsure which? Run: python scripts/check_key.py
LING_API_KEY=
LING_BASE_URL=https://zenmux.ai/api/v1
LING_MODEL=inclusionai/ling-3.0-flash

# --- Fallbacks, tried in order when the one above is unreachable -------------
# Some networks reset TLS to api.deepseek.com (SNI filtering). OpenRouter is
# reachable from those networks and serves the same DeepSeek V4 models.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# deepseek/deepseek-v4-flash costs ~$0.09 per 1M input tokens (pennies per demo).
# With no credit on the account, use a free model instead, e.g. z-ai/glm-5.2:free
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Any other OpenAI-compatible endpoint (local llama.cpp, vLLM, Azure, ...)
LLM_NAME=custom
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Behaviour ---------------------------------------------------------------
# A case is filed automatically once the agent clears both bars.
DECOY_AUTO_RECORD_SCORE=70
DECOY_AUTO_RECORD_CONFIDENCE=60
# Defaults to ./data/decoy.db
DECOY_DB_PATH=
# When no provider answers the decoy stays silent and the UI says so. Set to 1
# to let the canned offline heuristics answer instead (they cannot read context).
DECOY_ALLOW_FALLBACK=0
